# Cấu hình môi trường mẫu cho PDF Orientation Detector
# Sao chép file này thành `.env` nếu muốn tùy chỉnh đường dẫn hoặc tham số mặc định.

# Đường dẫn thực thi Tesseract OCR (để trống để tự động dò tìm trên hệ thống)
TESSERACT_CMD=

# Độ phân giải (DPI) khi render từng trang PDF phục vụ OCR
PDF_DETECTOR_RENDER_DPI=160

# Độ phân giải (DPI) khi render ảnh xem trước trên giao diện Streamlit
PDF_DETECTOR_PREVIEW_DPI=120

# Ngưỡng độ tin cậy tối thiểu để phân loại NORMAL / ROTATED
PDF_DETECTOR_CONF_THRESHOLD=10.0

# Tự động xoay các trang ROTATED khi chạy CLI (true / false)
PDF_DETECTOR_AUTO_FIX=false

# Thư mục lưu dữ liệu và log (tùy chọn)
# PDF_DETECTOR_DATA_DIR=./data
# PDF_DETECTOR_SAMPLES_DIR=./data/samples
# PDF_DETECTOR_UPLOADS_DIR=./data/uploads
# PDF_DETECTOR_OUTPUTS_DIR=./data/outputs
# PDF_DETECTOR_LOGS_DIR=./logs

